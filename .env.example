# Database
DATABASE_URL="postgresql://weaseln:weaseln_dev_password@localhost:5555/weaseln"
SHADOW_DATABASE_URL="postgresql://weaseln:weaseln_dev_password@localhost:5555/weaseln_shadow"

# NextAuth
# In production, set this to your deployment URL (e.g., https://yourdomain.com)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # Generate with: openssl rand -base64 32

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email Provider (Resend - https://resend.com)
RESEND_API_KEY=""
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER="resend"

# Socket.IO server
SOCKET_SERVER_SECRET="http://localhost:5000"

# QA: set to "1" to skip the cover-image upload requirement. The post editor
# will auto-apply /covers/cover-1.svg and the /api/post route stores the
# placeholder URL directly, so a full publish round trip can be exercised
# end-to-end without Cloudinary credentials.
# NEXT_PUBLIC_QA_NO_COVER=1
